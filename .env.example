# ============================================
# Sentiri — environment template
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# ============================================

# ----- Django -----
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# ----- Database -----
# Leave USE_SQLITE=1 for local dev (db.sqlite3). Set to 0 and provide
# DATABASE_URL for PostgreSQL (Render/Neon pattern).
USE_SQLITE=1
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ----- Redis (Celery broker + chatbot memory) -----
REDIS_URL=redis://localhost:6379/0

# ----- Reservation chatbot (OpenAI-compatible LLM) -----
# rootsys.cloud, Chat Completions API. Key must be rotated if ever exposed.
ROOTSYS_API_KEY=
ROOTSYS_BASE_URL=https://rootsys.cloud/v1
RESERVATION_MODEL=glm-5.3
DJANGO_API_BASE=http://localhost:8000/api

# ----- Optional: Groq (experimental LLM path in rag_service) -----
GROQ_API_KEY=
